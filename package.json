{
  "name": "compendium-staticcomponents",
  "version": "0.1.0",
  "description": "Static visual components for the Compendium Quartz wiki (logo, placeholders, etc.)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "quartz",
    "quartz-plugin",
    "compendium",
    "static-components",
    "component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1",
    "@quartz-community/utils": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "compendium-staticcomponents",
    "displayName": "Compendium Static Components",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 5,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "CobaltSoulLogo": {
        "displayName": "Cobalt Soul Logo",
        "defaultPosition": "left",
        "defaultPriority": 1
      },
      "Placeholder": {
        "displayName": "Static Placeholder",
        "defaultPosition": "left",
        "defaultPriority": 2
      }
    }
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
